@inherits LayoutComponentBase
@inject EstabelecimentoAppService EstabelecimentoAppService
@inject EstabelecimentoAtualService EstabelecimentoAtual
@implements IDisposable

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">MEI Financeiro</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Calculadoras</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="ponto-equilibrio">Ponto de Equilíbrio</a></li>
                            <li><a class="dropdown-item" href="precificacao">Preço de Venda</a></li>
                            <li><a class="dropdown-item" href="orcamento">Orçamento de Gastos</a></li>
                            <li><a class="dropdown-item" href="investimento">Retorno do Investimento</a></li>
                            <li><a class="dropdown-item" href="cmv">CMV Mensal</a></li>
                            <li><a class="dropdown-item" href="custo-funcionario">Custo de Funcionário</a></li>
                            <li><a class="dropdown-item" href="engenharia-cardapio">Engenharia de Cardápio</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="fechamento-mensal">Fechamento Mensal</a></li>
                    <li class="nav-item"><a class="nav-link" href="resumo">Resumo</a></li>
                    <li class="nav-item"><a class="nav-link" href="estabelecimentos">Estabelecimentos</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <label class="text-white-50 me-2 mb-0 small">Estabelecimento:</label>
                    <select class="form-select form-select-sm" style="width:auto"
                            value="@EstabelecimentoAtual.EstabelecimentoId" @onchange="OnTrocarEstabelecimento">
                        <option value="">Selecione...</option>
                        @foreach (var estabelecimento in _estabelecimentos)
                        {
                            <option value="@estabelecimento.Id">@estabelecimento.Nome</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1 bg-light">
        <div class="container-fluid py-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private List<Estabelecimento> _estabelecimentos = new();

    protected override async Task OnInitializedAsync()
    {
        EstabelecimentoAtual.Mudou += OnMudou;
        EstabelecimentoAtual.ListaMudou += OnListaMudouAsync;
        await CarregarEstabelecimentosAsync();

        if (EstabelecimentoAtual.EstabelecimentoId is null && _estabelecimentos.Count > 0)
        {
            var primeiro = _estabelecimentos[0];
            EstabelecimentoAtual.Definir(primeiro.Id, primeiro.Nome);
        }
    }

    private async Task CarregarEstabelecimentosAsync()
    {
        _estabelecimentos = await EstabelecimentoAppService.ListarAsync();
    }

    private async void OnListaMudouAsync()
    {
        await CarregarEstabelecimentosAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnMudou() => InvokeAsync(StateHasChanged);

    private void OnTrocarEstabelecimento(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var selecionado = _estabelecimentos.FirstOrDefault(x => x.Id == id);
            if (selecionado is not null)
                EstabelecimentoAtual.Definir(selecionado.Id, selecionado.Nome);
        }
        else
        {
            EstabelecimentoAtual.Limpar();
        }
    }

    public void Dispose()
    {
        EstabelecimentoAtual.Mudou -= OnMudou;
        EstabelecimentoAtual.ListaMudou -= OnListaMudouAsync;
    }
}
