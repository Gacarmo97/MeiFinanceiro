@page "/estabelecimentos"
@inject EstabelecimentoAppService EstabelecimentoAppService
@inject EstabelecimentoAtualService EstabelecimentoAtual

<PageTitle>Estabelecimentos</PageTitle>

<h1>Estabelecimentos</h1>
<p class="text-muted">Cadastre quantos negócios precisar — cada um tem sua própria atividade (define o DAS-MEI) e seu próprio histórico.</p>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(_editandoId is null ? "Novo estabelecimento" : "Editar estabelecimento")</h5>
        <EditForm Model="_form" OnValidSubmit="SalvarAsync">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Nome</label>
                    <InputText class="form-control" @bind-Value="_form.Nome" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Atividade (define o DAS)</label>
                    <InputSelect class="form-select" @bind-Value="_form.Atividade">
                        <option value="@AtividadeMei.Comercio">Comércio ou Indústria (ICMS)</option>
                        <option value="@AtividadeMei.Servico">Prestação de Serviços (ISS)</option>
                        <option value="@AtividadeMei.Ambos">Comércio e Serviços (ICMS + ISS)</option>
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Salário mínimo de referência (R$)</label>
                    <InputNumber class="form-control" @bind-Value="_form.SalarioMinimoReferencia" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@(_editandoId is null ? "Cadastrar" : "Atualizar")</button>
                @if (_editandoId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (_estabelecimentos.Count == 0)
{
    <p class="text-muted">Nenhum estabelecimento cadastrado ainda.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Atividade</th>
                <th class="text-end">Salário mínimo</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var estabelecimento in _estabelecimentos)
            {
                <tr>
                    <td>@estabelecimento.Nome</td>
                    <td>@DescricaoAtividade(estabelecimento.Atividade)</td>
                    <td class="text-end">@estabelecimento.SalarioMinimoReferencia.ToString("C")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarAsync(estabelecimento)">Editar</button>
                        @if (_idParaConfirmarExclusao == estabelecimento.Id)
                        {
                            <button class="btn btn-sm btn-danger ms-1" @onclick="() => ExcluirAsync(estabelecimento.Id)">Confirmar exclusão</button>
                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _idParaConfirmarExclusao = null">Cancelar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => _idParaConfirmarExclusao = estabelecimento.Id">Excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Estabelecimento> _estabelecimentos = new();
    private FormModel _form = new();
    private int? _editandoId;
    private int? _idParaConfirmarExclusao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _estabelecimentos = await EstabelecimentoAppService.ListarAsync();
    }

    private async Task SalvarAsync()
    {
        if (_editandoId is null)
        {
            await EstabelecimentoAppService.CriarAsync(_form.Nome, _form.Atividade, _form.SalarioMinimoReferencia);
        }
        else
        {
            await EstabelecimentoAppService.AtualizarAsync(_editandoId.Value, _form.Nome, _form.Atividade, _form.SalarioMinimoReferencia);
        }

        _form = new FormModel();
        _editandoId = null;
        await CarregarAsync();
        EstabelecimentoAtual.NotificarListaAlterada();
    }

    private Task EditarAsync(Estabelecimento estabelecimento)
    {
        _editandoId = estabelecimento.Id;
        _form = new FormModel
        {
            Nome = estabelecimento.Nome,
            Atividade = estabelecimento.Atividade,
            SalarioMinimoReferencia = estabelecimento.SalarioMinimoReferencia,
        };
        return Task.CompletedTask;
    }

    private void CancelarEdicao()
    {
        _editandoId = null;
        _form = new FormModel();
    }

    private async Task ExcluirAsync(int id)
    {
        await EstabelecimentoAppService.RemoverAsync(id);
        _idParaConfirmarExclusao = null;
        await CarregarAsync();
        EstabelecimentoAtual.NotificarListaAlterada();
    }

    private static string DescricaoAtividade(AtividadeMei atividade) => atividade switch
    {
        AtividadeMei.Comercio => "Comércio ou Indústria (ICMS)",
        AtividadeMei.Servico => "Prestação de Serviços (ISS)",
        AtividadeMei.Ambos => "Comércio e Serviços (ICMS + ISS)",
        _ => atividade.ToString()
    };

    private class FormModel
    {
        public string Nome { get; set; } = string.Empty;
        public AtividadeMei Atividade { get; set; } = AtividadeMei.Comercio;
        public decimal SalarioMinimoReferencia { get; set; } = 1518m;
    }
}
